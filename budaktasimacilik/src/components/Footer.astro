---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { company, navigation, whatsappUrl } from '../data/site';
const hrefFor = (href: string) => href.startsWith('#') && Astro.url.pathname !== '/' ? `/${href}` : href;
---
<footer class="site-footer"><div class="container"><div class="footer-main"><div class="footer-brand"><Brand inverse/><p>Yükünüze uygun çözümler.<br/>Planlı taşımacılık. Güçlü koordinasyon.</p><span class="footer-location"><span></span>Dilovası / Kocaeli</span></div><div><h2>HIZLI ERİŞİM</h2><nav aria-label="Alt menü">{navigation.map(link => <a href={hrefFor(link.href)}>{link.label}</a>)}</nav></div><div class="footer-contact"><h2>İLETİŞİM</h2><a href={`tel:${company.phoneHref}`}>{company.phone}</a><a href={`mailto:${company.emails[0].address}`}>{company.emails[0].address}</a><p>{company.address}</p></div><div><h2>ÇALIŞMA SAATLERİ</h2><p>{company.hours}</p><a class="footer-cta" href="/#iletisim">Birlikte planlayalım<Icon name="diagonal" size={17}/></a></div></div><div class="footer-bottom"><p>© {new Date().getFullYear()} {company.name}. Tüm hakları saklıdır.</p><a href="/#anasayfa">Yukarı dön <span aria-hidden="true">↑</span></a></div></div></footer>
<a class="whatsapp-float" href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp ile Budak Lojistik'e yazın"><svg width="27" height="27" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 2a14 14 0 0 0-12 21.2L2 30l7-1.8A14 14 0 1 0 16 2zm0 25a11 11 0 0 1-5.6-1.5l-.4-.2-4.1 1.1 1.1-4-.3-.5A11 11 0 1 1 16 27zm6-8.2c-.3-.2-2-1-2.3-1.1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.3-.7.1a9 9 0 0 1-4.4-3.8c-.3-.5.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.2-.6-.5-.5-.7-.5h-.6c-.3 0-.6.1-.9.4-2.3 2.5-.7 5.3 1 7.1 3.1 3.5 6 4.3 7.6 4.6 1 .2 2-.2 2.7-.8.8-.7 1-2 .8-2.2-.1-.2-.4-.3-.7-.5z"/></svg><span>WhatsApp</span></a>
